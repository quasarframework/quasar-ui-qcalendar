{
  "name": "docs",
  "version": "5.1.2",
  "private": true,
  "description": "QCalendar Documentation and examples",
  "author": "Jeff <galbraith64@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit --pretty false",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "pnpm run build:ssg",
    "postinstall": "quasar prepare",
    "build:spa": "quasar build",
    "build:ssg": "quasar prepare && quasar build && qpress ssg",
    "prerender:ssg": "qpress ssg",
    "preview:ssg": "quasar serve dist/spa --history",
    "check:qpress": "qpress check",
    "build:ssg:renderer": "quasar prepare && quasar build -m ssr"
  },
  "dependencies": {
    "@quasar/extras": "2.0.2",
    "@timestamp-js/calendar-hebrew": "0.1.0-rc.5",
    "@timestamp-js/calendar-islamic": "0.1.0-rc.5",
    "@timestamp-js/calendar-persian": "0.1.0-rc.5",
    "@timestamp-js/calendar-saka": "0.1.0-rc.5",
    "@timestamp-js/core": "0.1.0-rc.5",
    "date-holidays": "^3.33.0",
    "pinia": "^4.0.2",
    "quasar": "^2.22.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@md-plugins/quasar-app-extension-q-press": "1.2.0",
    "@md-plugins/search-ui": "1.2.0",
    "@md-plugins/vite-examples-plugin": "1.2.0",
    "@md-plugins/vite-md-plugin": "1.2.0",
    "@md-plugins/vite-search-plugin": "1.2.0",
    "@md-plugins/vite-ssg-plugin": "1.2.0",
    "@quasar/app-vite": "3.2.0",
    "@quasar/quasar-ui-qcalendar": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@vue/server-renderer": "^3.5.40",
    "autoprefixer": "^10.5.4",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "shiki": "^4.3.1",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.3.0"
  },
  "productName": "QCalendar Docs"
}
