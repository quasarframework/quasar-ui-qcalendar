{
  "name": "docs",
  "version": "5.4.0",
  "private": true,
  "description": "QCalendar Documentation and examples",
  "author": "Jeff <galbraith64@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit --pretty false",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "pnpm run build:ssg",
    "postinstall": "quasar prepare",
    "build:spa": "quasar build",
    "build:ssg": "quasar prepare && quasar build && qpress ssg",
    "prerender:ssg": "qpress ssg",
    "preview:ssg": "quasar serve dist/spa --history",
    "check:qpress": "qpress check",
    "build:ssg:renderer": "quasar prepare && quasar build -m ssr"
  },
  "dependencies": {
    "@quasar/extras": "2.1.0",
    "@timestamp-js/calendar-hebrew": "1.0.0",
    "@timestamp-js/calendar-islamic": "1.0.0",
    "@timestamp-js/calendar-persian": "1.0.0",
    "@timestamp-js/calendar-saka": "1.0.0",
    "@timestamp-js/core": "1.0.0",
    "date-holidays": "^3.38.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@md-plugins/quasar-app-extension-q-press": "2.2.1",
    "@md-plugins/search-ui": "2.2.1",
    "@md-plugins/vite-examples-plugin": "2.2.1",
    "@md-plugins/vite-md-plugin": "2.2.1",
    "@md-plugins/vite-search-plugin": "2.2.1",
    "@md-plugins/vite-ssg-plugin": "2.2.1",
    "@quasar/app-vite": "3.10.3",
    "@quasar/quasar-ui-qcalendar": "workspace:*",
    "@types/node": "^26.6.6",
    "@vue/server-renderer": "^3.5.45",
    "autoprefixer": "^10.6.2",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "shiki": "^4.6.0",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.5.0"
  },
  "productName": "QCalendar Docs"
}
