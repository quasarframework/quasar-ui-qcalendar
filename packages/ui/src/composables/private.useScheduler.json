{
  "props": {
    "view": {
      "type": "String",
      "category": "model",
      "desc": "The type of calendar view to be displayed",
      "applicable": ["scheduler"],
      "values": ["'month-interval'", "'week'", "'day'", "'month'"],
      "examples": ["'week'", "'month'"],
      "default": "# 'day'",
      "__runtimeDefault": true
    },
    "model-resources": {
      "type": "Array",
      "tsType": "ResourceObjectArray",
      "category": "model",
      "desc": "An array of objects with a single key of label. You can add other keys if you like, which will be passed back on the appropriate scoped slots",
      "applicable": ["scheduler"],
      "examples": ["[{ label: 'John' },{ label: 'Susan' }]"]
    },
    "resource-key": {
      "type": "String",
      "category": "model",
      "desc": "The key from the `resources` object that will be displayed",
      "default": "'id'",
      "applicable": ["scheduler"],
      "examples": ["'id'"]
    },
    "resource-label": {
      "type": "String",
      "category": "model",
      "desc": "The label from the `resources` object that will be displayed",
      "default": "'label'",
      "applicable": ["scheduler"],
      "examples": ["'label'", "'name'"]
    },
    "resource-height": {
      "type": ["Number", "String"],
      "category": "behavior",
      "desc": "The maximum height in pixels for the resource height",
      "default": "0",
      "applicable": ["scheduler"],
      "examples": ["80", "'100'"]
    },
    "resource-class": {
      "type": "Function",
      "desc": "A function that returns a class name for a resource",
      "category": "style",
      "default": "# null",
      "params": {
        "data": {
          "type": "Object",
          "desc": "The data passed to the function",
          "definition": {
            "scope": {
              "type": "Object",
              "desc": "The scope object",
              "definition": {
                "resource": {
                  "type": "Object",
                  "desc": "The resource object"
                },
                "resourceIndex": {
                  "type": "Number",
                  "desc": "The index of the resource in the model-resources array"
                },
                "timestamps": {
                  "type": "Array",
                  "tsType": "TimestampArray",
                  "desc": "The timestamps rendered for the scheduler row"
                },
                "indentLevel": {
                  "type": "Number",
                  "desc": "The indent level of the resource"
                },
                "label": {
                  "type": "String",
                  "desc": "The label of the resource"
                },
                "droppable": {
                  "type": "Boolean",
                  "desc": "True if the resource is currently a valid drop target"
                }
              }
            }
          }
        }
      },
      "returns": {
        "type": "String",
        "desc": "The class name to apply to the resource"
      }
    },
    "resource-style": {
      "type": "Function",
      "category": "style",
      "desc": "Gets called to provide custom styling of a resource",
      "params": {
        "data": {
          "type": "Object",
          "desc": "The data passed to the function",
          "__exemption": ["examples"],
          "definition": {
            "scope": {
              "type": "Object",
              "desc": "The scope object",
              "__exemption": ["examples"],
              "definition": {
                "resource": {
                  "type": "Object",
                  "tsType": "ResourceObject",
                  "desc": "The resource object",
                  "__exemption": ["examples"]
                },
                "resourceIndex": {
                  "type": "Number",
                  "desc": "The resource index",
                  "__exemption": ["examples"]
                },
                "timestamps": {
                  "type": "Array",
                  "tsType": "TimestampArray",
                  "desc": "The timestamps rendered for the scheduler row",
                  "__exemption": ["examples"]
                },
                "days": {
                  "type": "Array",
                  "tsType": "TimestampArray",
                  "desc": "Deprecated alias of `timestamps`",
                  "__exemption": ["examples"]
                },
                "indentLevel": {
                  "type": "Number",
                  "desc": "The indent level of the resource",
                  "__exemption": ["examples"]
                },
                "label": {
                  "type": "String",
                  "desc": "The label of the resource",
                  "__exemption": ["examples"]
                },
                "droppable": {
                  "type": "Boolean",
                  "desc": "True if the resource is currently a valid drop target",
                  "__exemption": ["examples"]
                }
              }
            }
          }
        }
      },
      "returns": {
        "type": ["Array", "Object", "String"],
        "desc": "A Vue style object",
        "examples": ["{ color: '#ccc' }"]
      },
      "default": "# null",
      "__runtimeDefault": true,
      "applicable": ["scheduler"],
      "examples": [
        "(data) => { return { 'background-color': '#c0c0c0' } }",
        "(data) => resourceStyle(data)"
      ]
    },
    "resource-min-height": {
      "type": ["Number", "String"],
      "default": "70",
      "desc": "The minimum height of a resource",
      "category": "behavior"
    },
    "weekday-style": {
      "type": ["Function"],
      "category": "style",
      "desc": "Gets called to provide custom styling of a weekday",
      "params": {
        "data": {
          "type": "Object",
          "desc": "The data passed to the function",
          "__exemption": ["examples"]
        }
      },
      "returns": {
        "type": "Object",
        "desc": "A Vue style object",
        "examples": ["{ color: '#ccc' }"]
      },
      "default": "# null",
      "__runtimeDefault": true
    },
    "weekday-class": {
      "type": "Function",
      "category": "style",
      "desc": "Gets called to provide custom classes for a weekday",
      "params": {
        "data": {
          "type": "Object",
          "desc": "The data passed to the function",
          "__exemption": ["examples"]
        }
      },
      "returns": {
        "type": "Object",
        "desc": "A Vue style object of classes",
        "examples": ["{ 'my-class': true }"]
      },
      "default": "# null",
      "__runtimeDefault": true
    },
    "day-style": {
      "type": "Function",
      "category": "style",
      "desc": "Gets called to provide custom styling of a day",
      "params": {
        "data": {
          "type": "Object",
          "desc": "The data passed to the function",
          "__exemption": ["examples"]
        }
      },
      "returns": {
        "type": ["Array", "Object", "String"],
        "desc": "A Vue style object",
        "examples": ["{ color: '#ccc' }"]
      },
      "default": "# null",
      "__runtimeDefault": true
    },
    "day-class": {
      "type": "Function",
      "category": "style",
      "desc": "Gets called to provide custom classes for a day",
      "params": {
        "data": {
          "type": "Object",
          "desc": "The data passed to the function",
          "__exemption": ["examples"]
        }
      },
      "returns": {
        "type": ["Array", "Object", "String"],
        "desc": "A Vue style object of classes",
        "examples": ["{ 'my-class': true }"]
      },
      "default": "# null",
      "__runtimeDefault": true
    },
    "date-header": {
      "type": "String",
      "category": "style",
      "desc": "Determines how the date header will be displayed",
      "values": ["'stacked'", "'inline'", "'inverted'"],
      "default": "'stacked'",
      "examples": ["'inline'"]
    }
  },
  "events": {}
}
