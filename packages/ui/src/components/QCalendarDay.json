  "methods": {
    "timeStartPos": {
      "desc": "Calculates the starting y position of the passed in time",
      "params": {
        "time": {
          "type": "String",
          "desc": "The time for which a position is needed in 24-hour format (HH:mm)",
          "examples": ["'09:00'"]
        },
        "clamp": {
          "type": "Boolean",
          "desc": "Clamp negative values to 0",
          "default": "true"
        }
      },
      "returns": {
        "type": "Number",
        "desc": "The absolute y starting position, but `false` on invalid time parameter",
        "examples": ["120", "482"]
      }
    },
    "timeDurationHeight": {
      "desc": "Given a duration (in minutes), will return the css height value",
      "params": {
        "duration": {
          "type": ["Number", "String"],
          "desc": "The number of minutes for the event to calculate it's height",
          "examples": ["'300'", "900"]
        }
      },
      "returns": {
        "type": "Number",
        "desc": "The height (in pixels) to be used for the event",
        "examples": ["80", "120"]
      }
    },
    "scrollToTime": {
      "desc": "When on an interval view, scroll to the passed in time (y position)",
      "returns": {
        "type": "Boolean",
        "desc": "If the procedure was successful or not"
      },
      "params": {
        "time": {
          "type": "String",
          "desc": "The time in which to scoll to. If the time is already visible on the viewport, this function will have no affect.",
          "required": true,
          "examples": ["'09:00'"]
        },
        "duration": {
          "type": "Number",
          "desc": "The amount of time in milliseconds to do the scroll",
          "examples": ["200"]
        }
      }
    }
  },
  "slots": {
    "head-intervals": {
      "desc": "Use this slot to add content to the interval header row"
    },
    "head-days-events": {
      "desc": "Use this slot to render multi-day content above the day columns"
    },
    "head-day": {
      "desc": "Replaces the complete internal day header"
    },
    "head-date": {
      "desc": "Appends content to the head day date area"
    },
    "head-day-event": {
      "desc": "Adds content to the head day event area"
    },
    "head-weekday-label": {
      "desc": "Replaces the weekday label in the day header"
    },
    "head-day-label": {
      "desc": "Replaces the day label in the day header button"
    },
    "head-day-button": {
      "desc": "Replaces the entire day header button"
    },
    "column-header-before": {
      "desc": "Adds content before the default column header content"
    },
    "column-header-after": {
      "desc": "Adds content after the default column header content"
    },
    "day-container": {
      "desc": "Adds content inside the day container below the headers"
    },
    "day-body": {
      "desc": "Adds content to the rendered day body"
    },
    "day-interval": {
      "desc": "Adds content to a rendered interval cell"
    },
    "interval-label": {
      "desc": "Replaces the default interval label"
    }
  }
}
