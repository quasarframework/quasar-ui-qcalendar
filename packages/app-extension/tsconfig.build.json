{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "lib": ["es2022", "dom"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": false,
    "target": "es2022"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
